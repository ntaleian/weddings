# Parent of public/ — DocumentRoot is THIS project folder.
# MARKER: weddings-path-v3-apex
#
# Absolute [R] paths only — relative "public/" leaks filesystem paths.
# Host-aware: apex path install vs subdomain /public/.

<IfModule mod_rewrite.c>
	RewriteEngine On

	# --- https://watotochurch.com/weddings/... ---
	RewriteCond %{HTTP_HOST} ^(www\.)?watotochurch\.com$ [NC]
	RewriteRule ^public/public(?:/(.*))?$ /weddings/public/$1 [R=301,L]

	RewriteCond %{HTTP_HOST} ^(www\.)?watotochurch\.com$ [NC]
	RewriteRule ^$ /weddings/public/ [R=302,L]

	# --- https://weddings.watotochurch.com|net/... ---
	RewriteCond %{HTTP_HOST} ^weddings\.watotochurch\.(com|net)$ [NC]
	RewriteRule ^public/public(?:/(.*))?$ /public/$1 [R=301,L]

	RewriteCond %{HTTP_HOST} ^weddings\.watotochurch\.(com|net)$ [NC]
	RewriteRule ^$ /public/ [R=302,L]
</IfModule>

# Disable directory browsing
# MARKER: weddings-path-v2 (no RewriteBase — works for /weddings/public and /public)
Options -Indexes
DirectoryIndex index.php

# ----------------------------------------------------------------------
# Rewrite engine (CodeIgniter front controller)
# ----------------------------------------------------------------------
<IfModule mod_rewrite.c>
	RewriteEngine On

	# Omit RewriteBase so both URL shapes work:
	#   https://watotochurch.com/weddings/public/
	#   https://weddings.watotochurch.com/public/
	# NEVER redirect to public/ from this file.

	# Skip rewrite engine for the exact app root (prevents dir↔slash self-loops)
	RewriteRule ^$ index.php [L]

	# Trailing-slash redirect — never for the app web root
	RewriteCond %{REQUEST_URI} !^/weddings/public/?$ [NC]
	RewriteCond %{REQUEST_URI} !^/public/?$ [NC]
	RewriteCond %{REQUEST_FILENAME} !-d
	RewriteCond %{REQUEST_URI} (.+)/$
	RewriteRule ^ %1 [L,R=301]

	# Existing files/dirs as-is; else front controller
	RewriteCond %{REQUEST_FILENAME} !-f
	RewriteCond %{REQUEST_FILENAME} !-d
	RewriteRule ^([\s\S]*)$ index.php/$1 [L,NC,QSA]

	RewriteCond %{HTTP:Authorization} .
	RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
</IfModule>

<IfModule !mod_rewrite.c>
	ErrorDocument 404 index.php
</IfModule>

<IfModule mod_php.c>
    php_value upload_max_filesize 10M
    php_value post_max_size 12M
</IfModule>
<IfModule mod_php8.c>
    php_value upload_max_filesize 10M
    php_value post_max_size 12M
</IfModule>
